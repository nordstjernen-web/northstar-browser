# Meson / Ninja
/builddir/
/builddir-release/
/builddir-verify/
/release-build/
/build-*/

.ninja_deps
.ninja_log
build.ninja
compile_commands.json

# Meson auto-downloaded subprojects (wrap files only are committed).
