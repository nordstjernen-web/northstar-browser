# releases.
/subprojects/packagecache/
/subprojects/lexbor/
/subprojects/quickjs-ng/
/subprojects/ns-pango/

# CMake (lexbor's subproject build)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/

# Editor / OS
*~
*.swp
*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-*

# Logs / scratch / tool output
/render-tests-out/
wptreport.json
*.log
/.scratch/
/.cache/
/local-build.log

# Local dev artifacts (Windows/MSYS2 box)
/.tmp/
/.ccache/

# Local Claude settings (allow .claude/settings.json if you want shared)
.claude/settings.local.json

# Claude harness state
/.claude/*
!/.claude/settings.json
!/.claude/skills/
!/.claude/skills/**
perf.data

# Python bytecode
__pycache__/
*.pyc
