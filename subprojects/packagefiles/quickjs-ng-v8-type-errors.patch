+static int js_callee_source(JSContext *ctx, char *out, int out_size)
+{
+    JSStackFrame *sf = ctx->rt->current_stack_frame;
+    JSFunctionBytecode *b;
+    JSObject *p;
+    uint32_t pc;
+    int line, col, off, i, depth, end;
+
+    if (!sf || !sf->cur_pc || JS_VALUE_GET_TAG(sf->cur_func) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!js_class_has_bytecode(p->class_id))
+        return 0;
+    b = p->u.func.function_bytecode;
+    if (!b->source || b->source_len <= 0)
+        return 0;
+    pc = sf->cur_pc - b->byte_code_buf - 1;
+    line = find_line_num(ctx, b, pc, &col);
+    if (line != b->line_num)
+        return 0;
+    off = col - b->col_num;
+    if (off < 0 || off >= b->source_len)
+        return 0;
+    depth = 0;
+    end = -1;
+    for (i = off; i < b->source_len; i++) {
+        uint8_t c = b->source[i];
+        if (c == '[' || c == '{') {
+            depth++;
+        } else if (c == ']' || c == '}') {
+            if (depth > 0)
+                depth--;
+        } else if (c == '(') {
+            if (depth == 0) {
+                end = i;
+                break;
+            }
+            depth++;
+        } else if (c == ')') {
+            if (depth > 0)
+                depth--;
+        } else if (depth == 0 && !(c >= 0x80 || lre_js_is_ident_next(c) || c == '.')) {
+            break;
+        }
+    }
+    if (end <= off || end - off >= out_size)
+        return 0;
+    memcpy(out, b->source + off, end - off);
+    out[end - off] = '\0';
+    return end - off;
+}
